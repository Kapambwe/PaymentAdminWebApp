{
  "App": {
    "Environment": "GitHub",
    "BaseHref": "/PaymentAdminWebApp/"
  },
  "Api": {
    "BaseUrl": "https://api-sandbox.rtpay.gov",
    "TimeoutSeconds": 30
  },
  "Features": {
    "UseMockData": true,
    "UseMockServices": true,
    "UseTestLogin": true,
    "EnableAnalytics": false,
    "EnableNotifications": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft": "Warning"
    }
  }
}
