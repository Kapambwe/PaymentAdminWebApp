{
  "App": {
    "Environment": "Production",
    "BaseHref": "/"
  },
  "Api": {
    "BaseUrl": "https://api.rtpay.gov",
    "TimeoutSeconds": 30,
    "MaxRetries": 3
  },
  "Features": {
    "UseMockData": false,
    "EnableAnalytics": true,
    "EnableNotifications": true,
    "EnableAuditLog": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Error",
      "Microsoft": "Error"
    }
  }
}
